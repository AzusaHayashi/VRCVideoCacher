<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same assembly name as the real app: the hook identifies its host by assembly name. -->
    <AssemblyName>VRCVideoCacher</AssemblyName>
    <RootNamespace>VRCVideoCacher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2099.1.1</Version>
    <AssemblyTitle>VRCVideoCacher (CookieBridge mock host)</AssemblyTitle>

    <!-- Two publish flavours, selected with -p:MockHostFlavor=fd|single.
         fd     : framework-dependent, NOT single-file  -> the CoreCLR startup-hook feature switch is ON,
                  so this is the variant that proves the DOTNET_STARTUP_HOOKS + reflection chain works.
         single : single-file + self-contained + trimmed -> the exact publishing shape of the shipped
                  VRCVideoCacher; its host disables System.StartupHookProvider, so it is the negative
                  control that documents the mechanism boundary. -->
    <PublishSingleFile Condition="'$(MockHostFlavor)' == 'single'">true</PublishSingleFile>
    <SelfContained Condition="'$(MockHostFlavor)' == 'single'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(MockHostFlavor)' == 'single'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(MockHostFlavor)' == 'single'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(MockHostFlavor)' == 'single'">true</EnableCompressionInSingleFile>
    <PublishTrimmed Condition="'$(MockHostFlavor)' == 'single'">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reflective entry points must survive trimming regardless of how Main happens to use them. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>

</Project>
