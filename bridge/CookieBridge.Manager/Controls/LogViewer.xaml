<UserControl x:Class="CookieBridge.Manager.Controls.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="820">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="PauseButton" Style="{StaticResource ActionButton}" Content="暂停"
                    Click="OnPauseClick" ToolTip="暂停/继续实时 tail" />
            <Button x:Name="ClearButton" Style="{StaticResource ActionButton}" Content="清空显示"
                    Click="OnClearClick" ToolTip="只清空界面，不删除日志文件" />
            <Button x:Name="OpenDirButton" Style="{StaticResource ActionButton}" Content="打开日志目录"
                    Click="OnOpenDirClick" />
            <Button x:Name="CopyButton" Style="{StaticResource ActionButton}" Content="复制选中行"
                    Click="OnCopyClick" ToolTip="没有选中时复制全部可见内容" />
            <Button x:Name="ReloadButton" Style="{StaticResource ActionButton}" Content="从头读取"
                    Click="OnReloadClick" />
        </WrapPanel>

        <!-- 状态行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock x:Name="StateText" Text="实时" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="#FF1B6E3A" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="PathText" FontSize="11.5" Foreground="#FF6B7488"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 日志正文：级别着色 -->
        <Border Grid.Row="2" BorderBrush="#FFDCE2EC" BorderThickness="1" CornerRadius="4" Background="#FFFFFFFF">
            <RichTextBox x:Name="LogBox"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         BorderThickness="0"
                         Padding="6"
                         FontFamily="Consolas, Cascadia Mono, Courier New"
                         FontSize="11.5"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#FFFFFFFF" />
        </Border>
    </Grid>
</UserControl>
