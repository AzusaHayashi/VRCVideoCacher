<Application x:Class="CookieBridge.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!-- ============================== 调色板 ============================== -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#FFF3F5F9" />
        <SolidColorBrush x:Key="BrushCardBg" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="BrushCardBorder" Color="#FFDCE2EC" />
        <SolidColorBrush x:Key="BrushText" Color="#FF1F2430" />
        <SolidColorBrush x:Key="BrushMuted" Color="#FF6B7488" />
        <SolidColorBrush x:Key="BrushAccent" Color="#FF2C6FB4" />
        <SolidColorBrush x:Key="BrushWarnBg" Color="#FFFFF6DA" />
        <SolidColorBrush x:Key="BrushWarnBorder" Color="#FFE8C55B" />
        <SolidColorBrush x:Key="BrushWarnText" Color="#FF6B4E00" />
        <SolidColorBrush x:Key="BrushDangerText" Color="#FFB3261E" />

        <!-- ============================== 卡片 ============================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>

        <!-- 左标签 / 右数值 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="Margin" Value="0,3,10,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="#FFF7F9FC" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}" />
            <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="{StaticResource BrushDangerText}" />
        </Style>

        <!-- 顶部横幅 -->
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushWarnBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushWarnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

    </Application.Resources>
</Application>
