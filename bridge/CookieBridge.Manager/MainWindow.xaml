<Window x:Class="CookieBridge.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:CookieBridge.Manager.Controls"
        Title="VRCVideoCacher CookieBridge 管理器"
        Height="860" Width="1140" MinHeight="640" MinWidth="960"
        Background="{StaticResource BrushWindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Language="zh-Hans"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ 标题栏 ============================ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="VRCVideoCacher CookieBridge 管理器"
                           FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushText}" />
                <TextBlock Style="{StaticResource SectionHint}" Margin="0,2,0,0"
                           Text="把浏览器里的 YouTube 登录 Cookie 安全地交给 VRCVideoCacher 的 yt-dlp 机制。管理器只调用 CookieBridge.Core，不碰 VRCVC 安装目录。" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 运行模式标识：契约模式 / 进程内模式（依据 HookStatus.IsFresh） -->
                <Border Background="#FFEDF3FB" BorderBrush="#FFCBDCF0" BorderThickness="1"
                        CornerRadius="11" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                        ToolTip="{Binding RunModeDetail}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding RunModeBrush}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding RunModeText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding RunModeBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="12" Foreground="{StaticResource BrushMuted}" />
                <Button Content="刷新状态" Style="{StaticResource ActionButton}" Margin="0"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- ==================== Steam 环境变量时效横幅 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Banner}" Visibility="{Binding SteamBannerVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SteamBannerText}" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushWarnText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="重启 Steam" Style="{StaticResource ActionButton}"
                        Margin="10,0,0,0" Background="#FFFFFFFF"
                        ToolTip="会先关闭 Steam（含正在运行的游戏/VRCVC），再自动启动。会先弹出确认框。"
                        Command="{Binding RestartSteamCommand}" />
            </Grid>
        </Border>

        <!-- ======================== 状态总览（三灯） ======================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="状态总览" Style="{StaticResource CardTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="13" Height="13" Fill="{Binding Overview.HookLight}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="插件" FontSize="12.5" Foreground="{StaticResource BrushMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Overview.HookState}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding Overview.HookTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overview.HookDetail}" Style="{StaticResource SectionHint}"
                                   Margin="21,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="13" Height="13" Fill="{Binding Overview.CookieLight}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Cookie" FontSize="12.5" Foreground="{StaticResource BrushMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Overview.CookieState}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding Overview.CookieTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overview.CookieDetail}" Style="{StaticResource SectionHint}"
                                   Margin="21,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="13" Height="13" Fill="{Binding Overview.VrcvcLight}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="VRCVC" FontSize="12.5" Foreground="{StaticResource BrushMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Overview.VrcvcState}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding Overview.VrcvcTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overview.VrcvcDetail}" Style="{StaticResource SectionHint}"
                                   Margin="21,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Background="#FFF7F9FC" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="运行模式：" FontSize="12" Foreground="{StaticResource BrushMuted}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RunModeText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding RunModeBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding RunModeHint}" FontSize="11.5"
                                   Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="780" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Overview.Headline}" Margin="0,8,0,0" FontSize="11.5"
                           Foreground="{StaticResource BrushMuted}" />
            </StackPanel>
        </Border>

        <!-- ============================ 主体页签 ============================ -->
        <TabControl Grid.Row="3" Background="{StaticResource BrushCardBg}" BorderBrush="{StaticResource BrushCardBorder}">

            <!-- ============================ 总览 ============================ -->
            <TabItem Header="总览">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快捷操作" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <Button Content="一键安装插件" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding InstallCommand}" />
                                    <Button Content="更新插件" Style="{StaticResource ActionButton}"
                                            ToolTip="重新复制 Hook DLL 并重新注册环境变量（等同安装）"
                                            Command="{Binding UpdateCommand}" />
                                    <Button Content="{Binding Plugin.ToggleButtonText}" Style="{StaticResource ActionButton}"
                                            ToolTip="禁用后 VRCVC 恢复原生行为（读取它自己的 youtube_cookies.txt），环境变量保留"
                                            Command="{Binding ToggleEnabledCommand}" />
                                    <Button Content="卸载插件" Style="{StaticResource DangerButton}"
                                            Command="{Binding UninstallCommand}" />
                                    <Button Content="运行自检" Style="{StaticResource ActionButton}"
                                            Command="{Binding RunSelfTestCommand}" />
                                    <Button Content="打开桥接目录" Style="{StaticResource ActionButton}"
                                            Command="{Binding OpenRootCommand}" />
                                </WrapPanel>
                                <CheckBox Content="同时注册 DOTNET__STARTUP__HOOKS（仅自编译 fork / 框架依赖宿主需要）"
                                          IsChecked="{Binding RegisterStartupHookOnInstall, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="安装 = 把 CookieBridge.Hook.dll 复制到 %LOCALAPPDATA%\VRCVideoCacher-CookieBridge\hook\（默认不写环境变量）；勾选上方的选项才会把这支 DLL 追加到用户级 DOTNET_STARTUP_HOOKS。VRCVideoCacher 的安装目录不会被修改。" />
                                <TextBlock Style="{StaticResource SectionHint}" Foreground="{StaticResource BrushWarnText}"
                                           Text="{Binding Plugin.InstallSemantics}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VRCVideoCacher 安装" Style="{StaticResource CardTitle}" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Height="28"
                                              ItemsSource="{Binding Vrcvc.Candidates}"
                                              SelectedItem="{Binding Vrcvc.Selected, Mode=TwoWay}"
                                              DisplayMemberPath="Display"
                                              ToolTip="自动发现的所有候选（Steam 库 / Program Files / 手动指定）" />
                                    <Button Grid.Column="1" Content="选择目录…" Style="{StaticResource ActionButton}"
                                            Margin="8,0,0,0" Command="{Binding BrowseInstallCommand}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="候选数量" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.CandidateCount}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="安装目录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.InstallDir}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="可执行文件" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.ExePath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="发现来源" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.Source}" Style="{StaticResource FieldValue}" />
                                </Grid>

                                <TextBlock Text="{Binding Vrcvc.ManualDirProblem}"
                                           Visibility="{Binding Vrcvc.ManualProblemVisibility}"
                                           Foreground="{StaticResource BrushDangerText}" TextWrapping="Wrap"
                                           FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="版本与兼容性（CompatibilityMatrix）" Style="{StaticResource CardTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VRCVC 版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.Version}" Style="{StaticResource FieldValue}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="版本来源" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.VersionSource}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="兼容等级" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.CompatLabel}" Style="{StaticResource FieldValue}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="结论" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.CompatHeadline}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="说明" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Vrcvc.CompatNotes}" Style="{StaticResource FieldValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="插件状态速览" Style="{StaticResource CardTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="安装状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.InstallState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="插件版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.Version}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="启用状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.EnabledState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 插件 ============================ -->
            <TabItem Header="插件">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="插件安装状态" Style="{StaticResource CardTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="安装状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.InstallState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="插件版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.Version}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="安装于" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.InstalledUtc}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DLL 路径" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.DllPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DLL 哈希（SHA256）" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.Hash}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="哈希校验" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.HashState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="启用状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.EnabledState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DOTNET_STARTUP_HOOKS" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.EnvValue}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="环境变量校验" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.EnvState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="问题清单" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.Problems}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="禁用标记路径" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.DisabledFlagPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="禁用标记当前值" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.DisabledFlagState}" Style="{StaticResource FieldValue}" />
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="一键安装插件" Style="{StaticResource PrimaryButton}"
                                            ToolTip="部署 Hook DLL 到桥接目录；是否注册 DOTNET_STARTUP_HOOKS 由下方勾选框决定（默认不注册）"
                                            Command="{Binding InstallCommand}" />
                                    <Button Content="更新插件" Style="{StaticResource ActionButton}"
                                            ToolTip="重新部署 Hook DLL（等同安装，注册行为同样由勾选框决定）"
                                            Command="{Binding UpdateCommand}" />
                                    <Button Content="{Binding Plugin.ToggleButtonText}" Style="{StaticResource ActionButton}"
                                            ToolTip="禁用 = 写 disabled.flag 让 Hook 完全静默；契约模式仍由 NativeHost 生效"
                                            Command="{Binding ToggleEnabledCommand}" />
                                    <Button Content="卸载插件" Style="{StaticResource DangerButton}"
                                            Command="{Binding UninstallCommand}" />
                                </WrapPanel>

                                <CheckBox Content="同时注册 DOTNET__STARTUP__HOOKS（仅自编译 fork / 框架依赖宿主需要）"
                                          IsChecked="{Binding RegisterStartupHookOnInstall, Mode=TwoWay}"
                                          FontSize="12" Margin="0,2,0,4" />
                                <TextBlock Text="{Binding StartupHookCheckboxHint}" Style="{StaticResource SectionHint}"
                                           Margin="0,0,0,6" />

                                <TextBlock Style="{StaticResource SectionHint}" Margin="0,4,0,0"
                                           Text="禁用效果：只写一个 disabled.flag，Hook 完全静默（不再接管任何进程内同步）。契约模式不受影响 —— Cookie 仍由本地写入程序通过 VRCVC 自己的 youtube_cookies.txt 生效。环境变量与 DLL 都保留，随时可以再启用。" />

                                <Expander Margin="0,8,0,0" FontSize="12"
                                          Header="技术说明：为什么 Steam 版无法进程内注入（点击展开）">
                                    <Border Background="#FFF7F9FC" BorderBrush="{StaticResource BrushCardBorder}"
                                            BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Plugin.TechNote}" Style="{StaticResource FieldValue}" />
                                            <TextBlock Text="{Binding Plugin.TechNote2}" Style="{StaticResource FieldValue}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="插件运行状态（进程内心跳）" Style="{StaticResource CardTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Live.Light}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Live.RunningState}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PID" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.Pid}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="VRCVC 版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Live.VrcvcVersion}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hook 版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.HookVersion}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="开始时间" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Live.Started}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最后心跳" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.Heartbeat}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="最后同步" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Live.LastSync}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="同步结果" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.SyncResult}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="同步次数" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Live.SyncCount}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="监听 vault" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.VaultWatching}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最后错误" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Live.LastError}" Style="{StaticResource FieldValue}" />
                                </Grid>

                                <TextBlock Text="Layers 探测表" FontSize="12.5" FontWeight="SemiBold" Margin="0,10,0,2" />
                                <TextBlock Text="{Binding Live.LayersEmpty}" Style="{StaticResource SectionHint}" />
                                <DataGrid ItemsSource="{Binding Live.Layers}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          Height="150" Margin="0,4,0,0"
                                          Background="#FFFFFFFF" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="层（反射能力）" Binding="{Binding Layer}" Width="200" />
                                        <DataGridTextColumn Header="结果" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource SectionHint}" Margin="0,4,0,0"
                                           Text="L1=写 Cookie 文件，L2=进程内串行锁，L3=通知 UI，L4=有效性判定，L5=版本号，L6=Cookie 变化事件。resolved=可用，absent/fallback=已降级。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ Cookie ============================ -->
            <TabItem Header="Cookie">
