                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Cookie Vault（DPAPI 密文）" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="浏览器扩展推送的 Cookie 先落在 vault.json（DPAPI 当前用户加密）。这里只显示条数 / 时间 / 布尔值，永不显示 Cookie 名称或值。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vault 状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最后更新时间" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultUpdated}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cookie 条数" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultCount}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="登录 Cookie" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultLogin}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="保护方式" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultProtection}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="来源浏览器" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.VaultSource}" Style="{StaticResource FieldValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VRCVC 目标 Cookie 文件（yt-dlp 契约）" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="%APPDATA%\VRCVideoCacher\youtube_cookies.txt —— 这是与 VRCVideoCacher 之间唯一的耦合点，跨版本稳定。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文件路径" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.TargetPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="是否存在" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.TargetExists}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="是否可读" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Cookie.TargetReadable}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VRCVC 判定有效" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.TargetValid}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="条数" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Cookie.TargetCount}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="登录 Cookie" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.TargetLogin}" Style="{StaticResource FieldValue}" />
                                    <TextBlock Grid.Column="2" Text="文件大小" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Cookie.TargetSize}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最后写入" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Cookie.TargetLastWrite}" Style="{StaticResource FieldValue}" />
                                </Grid>

                                <Border Background="#FFF7F9FC" BorderBrush="{StaticResource BrushCardBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Cookie.WritePolicyNote}" FontSize="11.5"
                                               Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                                </Border>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="打开 VRCVC 数据目录" Style="{StaticResource ActionButton}"
                                            Command="{Binding OpenVrcvcDataDirCommand}" />
                                    <Button Content="打开日志目录" Style="{StaticResource ActionButton}"
                                            Command="{Binding OpenLogDirCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 浏览器 ============================ -->
            <TabItem Header="浏览器">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Native Messaging Host 注册" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="注册写入 HKCU（无需管理员、不改机器级设置），让浏览器扩展把 Cookie 交给本地写入程序 CookieBridge.NativeHost.exe。扩展 ID 默认从 browser-extension\extension-id.txt 读取，读不到就留空手动填。" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="扩展 ID（Chromium）" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Native.ExtensionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="可填多个，用逗号分隔；也接受 chrome-extension://&lt;id&gt;/ 形式" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="扩展 ID（Firefox）" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding Native.FirefoxId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Firefox 使用扩展 ID，例如 vrexcookiebridge@local" />
                                </Grid>

                                <WrapPanel Margin="0,4,0,6">
                                    <Button Content="注册 Native Host" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RegisterNativeCommand}" />
                                    <Button Content="注销注册" Style="{StaticResource DangerButton}"
                                            Command="{Binding UnregisterNativeCommand}" />
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="注册状态" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Native.RegistryState}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="已注册浏览器" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Native.RegisteredBrowsers}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="本地写入程序" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Native.HostExe}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Chromium 清单" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Native.ChromiumManifest}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Firefox 清单" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Native.FirefoxManifest}" Style="{StaticResource Mono}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 备份 ============================ -->
            <TabItem Header="备份 / 恢复">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="备份说明" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Backups.Explanation}" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="创建备份" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateBackupCommand}" />
                        <Button Content="从选中备份恢复" Style="{StaticResource DangerButton}"
                                ToolTip="恢复前会二次确认"
                                Command="{Binding RestoreBackupCommand}" />
                        <Button Content="刷新列表" Style="{StaticResource ActionButton}"
                                Command="{Binding RefreshBackupsCommand}" />
                        <Button Content="打开备份目录" Style="{StaticResource ActionButton}"
                                Command="{Binding OpenBackupDirCommand}" />
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Backups.Items}"
                             SelectedItem="{Binding Backups.Selected, Mode=TwoWay}"
                             BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1"
                             Background="#FFFFFFFF" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12.5"
                                           Margin="2,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3" Text="{Binding Backups.Summary}" Style="{StaticResource SectionHint}"
                               Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <!-- ============================ 自检 ============================ -->
            <TabItem Header="运行自检">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="开始自检" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunSelfTestCommand}" />
                        <Button Content="复制报告" Style="{StaticResource ActionButton}"
                                Command="{Binding CopyReportCommand}" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding SelfTestReport, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11.5"
                             Background="#FFFFFFFF" BorderBrush="{StaticResource BrushCardBorder}" />
                </Grid>
            </TabItem>

            <!-- ============================ 日志 ============================ -->
            <TabItem Header="插件日志">
                <Grid Margin="12">
                    <ctl:LogViewer />
                </Grid>
            </TabItem>

            <!-- ============================ 关于 ============================ -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="关于本管理器" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource FieldValue}"
                                           Text="VRCVideoCacher CookieBridge 管理器 —— 一个 WPF（net10.0-windows，零 NuGet 依赖）图形前端，用来安装/启停进程内插件、检查 Cookie 链路、备份恢复与跑自检。所有真实逻辑都在 CookieBridge.Core 里，管理器只是一个调用方。" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="版本" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource FieldValue}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="运行框架" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text=".NET 10 / WPF（需要已安装 .NET 10 Desktop Runtime）"
                                               Style="{StaticResource FieldValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="上游项目" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource FieldValue}">
                                    <Hyperlink NavigateUri="https://github.com/EllyVR/VRCVideoCacher"
                                               RequestNavigate="OnHyperlinkNavigate">VRCVideoCacher（EllyVR/VRCVideoCacher）</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="本项目是围绕 VRCVideoCacher 的第三方桥接实现：复用它的 yt-dlp Cookie 文件契约（%APPDATA%\VRCVideoCacher\youtube_cookies.txt），不修改它的安装目录，也不包含它的任何代码。" />
                                <TextBlock Style="{StaticResource FieldValue}" Margin="0,6,0,0">
                                    <Hyperlink NavigateUri="https://github.com/EllyVR/VRCVideoCacher/wiki"
                                               RequestNavigate="OnHyperlinkNavigate">上游 Wiki / 文档</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="许可证说明" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource FieldValue}"
                                           Text="CookieBridge（bridge\ 下的 Core / Hook / NativeHost / Manager）是独立实现，遵循其所在仓库的授权条款；上游 VRCVideoCacher 的代码与许可证归 EllyVR 所有，本仓库当前未随附上游 LICENSE 文件，分发前请以上游仓库为准。" />
                                <TextBlock Style="{StaticResource SectionHint}"
                                           Text="免责：本工具只在你自己的账户与机器上读写你自己浏览器导出的登录 Cookie；vault 用 DPAPI（当前用户）加密，备份目录中的 youtube_cookies.txt 为明文，请自行妥善保管。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="运行环境提示" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource FieldValue}"
                                           Text="管理器正常使用时只需要普通用户权限：写入 %LOCALAPPDATA%\VRCVideoCacher-CookieBridge（vault / 日志 / 安装记录 / 备份）、用户级环境变量（仅在你勾选时）、以及 HKCU 下的浏览器 Native Messaging 注册项。" />
                                <TextBlock Style="{StaticResource SectionHint}" Margin="0,4,0,0"
                                           Text="如果自检里出现 UnauthorizedAccessException（例如“桥接根目录不可用”），说明当前进程被安全软件或沙箱限制了写入：请从资源管理器直接双击运行本程序，而不是从受限的父进程（脚本/自动化工具/任务栏沙箱）启动。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="路径一览" Style="{StaticResource CardTitle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="桥接根目录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RootPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="插件 DLL" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding HookDllPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="日志文件" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding LogPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VRCVC 数据目录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding VrcvcDataPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="备份目录" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BackupRootPath}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Native Host 名" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding NativeHostName}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="控制管道" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding PipeName}" Style="{StaticResource Mono}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="环境变量" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartupHooksVariable}" Style="{StaticResource Mono}" />
                                </Grid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="打开日志目录" Style="{StaticResource ActionButton}"
                                            Command="{Binding OpenLogDirCommand}" />
                                    <Button Content="打开桥接目录" Style="{StaticResource ActionButton}"
                                            Command="{Binding OpenRootCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ====================== 最近一次操作结果 ====================== -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Visibility="{Binding LastOperationVisibility}"
                Margin="0,8,0,0" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="最近一次操作结果" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushMuted}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LastOperation}" Style="{StaticResource Mono}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================ 状态栏 ============================ -->
        <Border Grid.Row="5" Margin="0,8,0,0" Padding="8,5" CornerRadius="4"
                Background="#FFFFFFFF" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{StaticResource BrushMuted}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="所有操作均调用 CookieBridge.Core" />
            </Grid>
        </Border>

    </Grid>
</Window>
