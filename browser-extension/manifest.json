{
  "manifest_version": 3,
  "name": "VRCVideoCacher CookieBridge",
  "description": "Exports YouTube login cookies to the local VRCVideoCacher CookieBridge native host (no local HTTP server required).",
  "version": "1.0.0",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "key": "",
  "minimum_chrome_version": "109",
  "background": {
    "service_worker": "background.mjs",
    "scripts": [
      "background.mjs"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "CookieBridge: 查看同步状态"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vrexcookiebridge@local",
      "strict_min_version": "138.0"
    }
  }
}
